# Token du bot (Discord Developer Portal → Bot → Reset Token)
# Ne jamais coller le vrai token ici : ce fichier est public sur GitHub.
# Copie ce fichier vers .env (gitignoré) et remplis les secrets là.
DISCORD_TOKEN=

# Serveur Discord (ID). Laisse vide pour des commandes globales.
GUILD_ID=

# Rôle(s) staff : /ban /unban /warn /unwarn /analyse /ticket-panel /confession-log /règlement
# IDs séparés par des virgules
ADMIN_ROLE_IDS=

# Optionnel : ID utilisateur avec accès admin (fondateur)
FOUNDER_USER_ID=

# Intent Privileged « Server Members Intent » (Developer Portal) — autocomplétion + /analyse
GUILD_MEMBERS_INTENT=true
# Intent Privileged « Message Content Intent » — texte des preuves dans les fils de signalement
MESSAGE_CONTENT_INTENT=true

# Limite de commandes staff par minute et par utilisateur
RATE_LIMIT_PER_MINUTE=10

# Couleurs des embeds (hex, avec ou sans #)
EMBED_COLOR_SANCTION=#C8102E
EMBED_COLOR_OTHER=#C8102E

# Marque affichée dans l’auteur des embeds
EMBED_BRAND=Péché Mignon
# Texte du footer des embeds
EMBED_FOOTER=Péché Mignon +18 | © All rights reserved.

# —— Tickets (threads privés) ——
# Rôles pingés à l’ouverture d’un ticket (IDs séparés par des virgules)
TICKET_STAFF_ROLE_IDS=
# Salon parent des fils (sinon le salon où est posté /ticket-panel)
TICKET_CHANNEL_ID=
# Salon des transcripts (tickets fermés)
TICKET_TRANSCRIPT_CHANNEL_ID=
# Salon des modalités (mention cliquable dans le panneau tickets)
TICKET_PARTENARIAT_MODALITES_CHANNEL_ID=
# Salon des signalements (embed posté après chaque ban)
BAN_LOG_CHANNEL_ID=

# —— Présentations ——
PRESENTATION_CHANNEL_ID=
# Émojis sous chaque présentation (max 2). Si vide : les 2 premiers de SELFIE_REACTION_IDS
# PRESENTATION_REACTION_1=
# PRESENTATION_REACTION_2=
PRESENTATION_RESET_CHANNEL_IDS=

# —— Selfies / auto-fil / auto-react ——
# Salons images hors catégories (IDs séparés par des virgules)
SELFIE_CHANNEL_IDS=
# Réactions auto hors catégories, dans l’ordre (IDs ou URL CDN, animated=true pour les GIF)
SELFIE_REACTION_IDS=https://cdn.discordapp.com/emojis/1547952977904672779.webp?size=96,https://cdn.discordapp.com/emojis/1547955071482863738.webp?size=96,https://cdn.discordapp.com/emojis/1547941437352710195.webp?size=96&animated=true,https://cdn.discordapp.com/emojis/1547941554679976027.webp?size=96&animated=true
# Salons avec fil auto sous les images et les liens (IDs séparés par des virgules)
AUTO_THREAD_CHANNEL_IDS=
# Catégories : tous les salons enfants ont auto-fil + auto-react
AUTO_MEDIA_CATEGORY_IDS=1547944407414870099,1547944446740533258,1547944496858144778
# Réactions auto des salons dans ces catégories (ordre)
CATEGORY_REACTION_IDS=https://cdn.discordapp.com/emojis/1547941480847376417.webp?size=96&animated=true,https://cdn.discordapp.com/emojis/1547942817945485402.webp?size=96,https://cdn.discordapp.com/emojis/1547940917686833263.webp?size=96&animated=true,https://cdn.discordapp.com/emojis/1547941554679976027.webp?size=96&animated=true

# —— Règlement ——
# Rôle donné par le bouton « Lu et approuvé »
REGLEMENT_MEMBER_ROLE_ID=1547936966341951569
# Emoji du titre (`<:nom:id>` ou unicode). Si vide : 🌸
REGLEMENT_SAKURA_EMOJI=

# —— Informations ——
# Salon de l’embed /informations
INFO_CHANNEL_ID=
# Rôles mentionnés dans /informations
INFO_LEVEL_1_ROLE_ID=1547977553543700620
INFO_LEVEL_5_ROLE_ID=1547979262135631964
INFO_LEVEL_15_ROLE_ID=1547979215478194296
INFO_LEVEL_50_ROLE_ID=1547948801833177259
INFO_BOOST_ROLE_ID=1547921834673176648
# Salon MP mentionné dans l’embed informations
INFO_MP_CHANNEL_ID=

# —— Bienvenue ——
# Salon des phrases aléatoires (mention cliquable)
WELCOME_CHANNEL_ID=1547939061627486332
# Rôles qui déclenchent le message (premier acquis parmi ces IDs)
WELCOME_ROLE_IDS=1547947506757799966,1547936068488400896

# Rôles qui voient /confession, /confession-réponse et /présentation
MEMBER_SLASH_ROLE_IDS=1547936068488400896,1547947506757799966

# —— Logs messages (suppressions + éditions) ——
MESSAGE_LOG_CHANNEL_ID=1547971283978035213

# —— Confessions ——
# À configurer sur le nouveau serveur avec /confession-log configurer
# (salon public + salon logs staff)

# MongoDB : même URI que L’éphémère (même VPS, souvent localhost), base isolée peche_mignon.
# Si absent : SQLite local dans data/peche-mignon.db
# MONGODB_URI=

# Verrou d’instance (évite deux processus Discord en parallèle)
# PECHE_MIGNON_INSTANCE_OWNER=
# PECHE_MIGNON_INSTANCE_LOCK_KEY=peche-mignon-main
# PECHE_MIGNON_DISABLE_INSTANCE_LOCK=true
